# React Native + pnpm : le linker isolé casse la résolution Metro.
node-linker=hoisted
shamefully-hoist=true
auto-install-peers=true

# ⚠️ NE PAS remettre en liens physiques (le défaut de pnpm).
#
# Par défaut, pnpm crée des LIENS PHYSIQUES depuis son magasin global. Les liens
# physiques partagent l'inode — donc les attributs de fichier. Or d'autres projets
# du poste vivent encore sous OneDrive : OneDrive marque leurs fichiers d'un
# `ReparsePoint`, et cette marque contamine TOUTES les copies liées, y compris
# celles hors OneDrive.
#
# Conséquence observée le 2026-08-07 : 2 208 fichiers de `node_modules` portaient
# `ReparsePoint` alors qu'ils ne sont pas des liens symboliques. `metro-file-map`
# en déduit un lien symbolique, appelle `readlink()`, et Windows répond
# `EINVAL: invalid argument` → Metro refuse de démarrer.
#
# `copy` casse le partage d'inode : chaque projet a ses propres fichiers, avec des
# attributs propres. Coût : un peu plus de disque et d'installation.
package-import-method=copy
