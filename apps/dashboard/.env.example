# ─── Développement local ──────────────────────────────────────────────────────
# Stack locale (`supabase start`), ports 5413x (voir supabase/config.toml).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54131
NEXT_PUBLIC_SUPABASE_ANON_KEY=colle_ici_la_anon_key_affichee_par_supabase_start

# ─── Production (Render) ──────────────────────────────────────────────────────
# Ces valeurs se saisissent dans l'interface Render, PAS ici :
#   NEXT_PUBLIC_SUPABASE_URL=https://rjumgzqcqbdukvgnfyok.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon du projet>
#
# ⛔ Aucune variable `DATABASE_URL` / `DIRECT_URL` n'est utilisée par ce projet.
# Les chaînes de connexion Postgres visibles dans le tableau de bord Supabase
# s'adressent à Prisma / Drizzle / TypeORM ; ici tout passe par
# `@supabase/supabase-js` en HTTP, et les migrations par le CLI Supabase.
