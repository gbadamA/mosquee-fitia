{
  "expo": {
    "name": "Mosquée Fitya",
    "slug": "mosquee-fitia",
    "scheme": "mosqueefitia",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.mosquee.fitia"
    },
    "android": {
      "package": "ci.mosquee.fitia",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a379a648-3590-4e3a-8806-0be5f4c5565b"
      }
    },
    "owner": "gbadamutiyu"
  }
}
